          <datasource-dependencies datasource='federated.05fg1nu0sh7x6x1goc2h30igvlvs'>
            <column caption='Average Order Value' datatype='real' name='[Calculation_1309274516758531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales]) / COUNTD([order_id])' />
            </column>
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
