      <aliases enabled='yes' />
      <column caption='Customer First Order Date' datatype='date' name='[Calculation_0807348168089600]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [customer_id]: MIN([order_date])}' />
      </column>
      <column caption='Customer Cohort Month' datatype='datetime' name='[Calculation_0807348168224769]' role='dimension' type='ordinal'>
