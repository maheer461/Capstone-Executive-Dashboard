      <table>
        <view>
          <datasources>
            <datasource caption='sales.csv+ (Multiple Connections)' name='federated.05fg1nu0sh7x6x1goc2h30igvlvs' />
          </datasources>
          <datasource-dependencies datasource='federated.05fg1nu0sh7x6x1goc2h30igvlvs'>
            <column caption='Customer First Order Date' datatype='date' name='[Calculation_0807348168089600]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [customer_id]: MIN([order_date])}' />
            </column>
            <column caption='Customer Cohort Month' datatype='datetime' name='[Calculation_0807348168224769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, {FIXED [customer_id]: MIN([order_date])})' />
            </column>
            <column caption='Months Since First Purchase' datatype='integer' name='[Calculation_0807348168306690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_0807348168089600], [order_date])' />
            </column>
            <column caption='Cohort Month Text' datatype='string' name='[Calculation_0807348168445955]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Calculation_0807348168224769]) + &apos; &apos; + &#13;&#10;DATENAME(&apos;year&apos;, [Calculation_0807348168224769])' />
            </column>
